{
  "name": "automodeai",
  "version": "1.0.0",
  "description": "AutoMode AI — Swarm Agent Orchestrator powered by Claude",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "swarm:sitegen": "tsx src/index.ts --swarm sitegen",
    "swarm:edunet": "tsx src/index.ts --swarm edunet",
    "swarm:contentops": "tsx src/index.ts --swarm contentops",
    "swarm:bizanalyst": "tsx src/index.ts --swarm bizanalyst",
    "swarm:list": "tsx src/index.ts --list",
    "test": "node --import tsx --test src/core/context.test.ts src/core/env.test.ts src/core/agent.test.ts src/core/swarm.test.ts src/core/deepseek.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modedigicreations/Automodeai.git"
  },
  "author": "Mode Digital Creations Limited",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
