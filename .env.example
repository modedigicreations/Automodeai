ANTHROPIC_API_KEY=your-api-key-here
DEEPSEEK_API_KEY=

# Dedicated local directory for generated static websites.
AUTOMODE_SITE_WORKSPACE=./generated-sites/current
# Set to true only when the agent should be allowed to replace existing files.
AUTOMODE_ALLOW_FILE_OVERWRITE=false

# Railway deployment is disabled unless explicitly enabled.
AUTOMODE_RAILWAY_AUTO_DEPLOY=false
RAILWAY_TOKEN=
AUTOMODE_RAILWAY_PROJECT_ID=
AUTOMODE_RAILWAY_ENVIRONMENT_ID=
AUTOMODE_RAILWAY_SERVICE_ID=
